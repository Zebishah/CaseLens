# =========================================================
# APPLICATION
# =========================================================

NODE_ENV=development
PORT=3002

APP_NAME=HR Intelligence
API_PUBLIC_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

TRUST_PROXY=false
LOG_LEVEL=info

RUN_API=true

# Portfolio inline mode does NOT run BullMQ workers.
RUN_WORKERS=false

# Disable the BullMQ/outbox dispatcher in inline portfolio mode
# so it does not continuously touch Redis.
RUN_OUTBOX_DISPATCHER=false
JOB_PROCESSING_MODE=inline
LLM_MODE=live

# =========================================================
# POSTGRESQL
# =========================================================

# Pooled connection for normal application queries.
# If Neon adds channel_binding=require, remove it — node-pg times out on cold start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/db_name?sslmode=require

# Direct, non-pooled connection for migrations (optional).
DATABASE_MIGRATION_URL=

# =========================================================
# REDIS / BULLMQ
# =========================================================

# Required only when JOB_PROCESSING_MODE=bullmq. Use the TLS/TCP URL, not a REST URL.
REDIS_URL=

QUEUE_PREFIX=hr-intelligence
QUEUE_JOB_ATTEMPTS=5
QUEUE_BACKOFF_MS=1000
QUEUE_CONCURRENCY=3

# =========================================================
# AUTHENTICATION AND SECURITY
# Generate a different random value for every secret.
# JWT_ACCESS_SECRET is also read as JWT_SECRET by the backend.
# Never expose these as NEXT_PUBLIC_*.
# =========================================================

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-a-long-random-string
DEMO_SESSION_SECRET=change-me-to-a-long-random-string

# Aliases kept by env.config.ts
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=caseops_session
CSRF_COOKIE_NAME=caseops_csrf

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# =========================================================
# GEMINI / LLM
# =========================================================

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROMPT_VERSION=extraction-v4
EMPLOYEE_MATCH_MIN_CONFIDENCE=75
MANUAL_REVIEW_CONFIDENCE=60

LIVE_LLM_ENABLED=true
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

DEMO_LLM_MAX_REQUESTS_PER_SESSION=3
DEMO_LLM_DAILY_LIMIT=50

# =========================================================
# RESEND — INBOUND EMAIL
# =========================================================

RESEND_ENABLED=false
RESEND_INBOUND_ENABLED=false
RESEND_OUTBOUND_ENABLED=false

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_DOMAIN=

# Only needed when outbound email is enabled.
EMAIL_FROM=HR Intelligence <cases@example.com>

# =========================================================
# PUBLIC DEMONSTRATION LIMITS
# =========================================================

DEMO_MODE=true
DEMO_SESSION_TTL_MINUTES=60
DEMO_SESSION_TTL_HOURS=24
DEMO_MAX_CASES_PER_SESSION=5
DEMO_MAX_EMAILS_PER_SESSION=3
DEMO_MAX_EMAILS=8
DEMO_MAX_SAMPLE_CASES=12
DEMO_MAX_LIVE_LLM=3
DEMO_DATA_RETENTION_HOURS=24
DEMO_RETENTION_HOURS=48

MAX_CASE_TEXT_LENGTH=20000
MAX_EMAIL_BYTES=1048576
ATTACHMENTS_ENABLED=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Local operator account for signed-in case review. Override before seeding.
# SEED_ADMIN_EMAIL=operator@northwind.co
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_NAME=Sarah Chen

# Read-only account for recruiter reviews. Required by npm run db:seed-viewer.
# SEED_VIEWER_EMAIL=reviewer@example.com
# SEED_VIEWER_PASSWORD=generate-a-strong-unique-password
# SEED_VIEWER_NAME=Recruiter Review

# =========================================================
# OPTIONAL ORIGINAL INTEGRATIONS
# =========================================================

BOX_SYNC_ENABLED=false
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FILE_ID=
STORE_DIRECTORY_SYNC_CRON=0 0 * * *

S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SENTRY_ENABLED=false
MONITORING_ENABLED=false
SENTRY_DSN=

# =========================================================
# INTERCOM DEVELOPER WORKSPACE
# Credentials required only when INTERCOM_ENABLED=true.
# Access token and client secret are backend-only. Never use NEXT_PUBLIC_*.
# =========================================================

INTERCOM_ENABLED=false
INTERCOM_ACCESS_TOKEN=
INTERCOM_CLIENT_SECRET=
# Deprecated alias for INTERCOM_CLIENT_SECRET (existing deployments).
# INTERCOM_WEBHOOK_SECRET=

INTERCOM_API_BASE_URL=https://api.intercom.io
INTERCOM_API_VERSION=2.16

INTERCOM_WORKSPACE_ID=
INTERCOM_ADMIN_ID=
# Deprecated alias for INTERCOM_ADMIN_ID.
# INTERCOM_BOT_ADMIN_ID=

INTERCOM_WRITEBACK_ENABLED=true
INTERCOM_INBOX_APP_ENABLED=true
# When false, internal notes still write back; conversation tags are skipped.
INTERCOM_WRITEBACK_TAGS_ENABLED=true

INTERCOM_REQUEST_TIMEOUT_MS=8000
INTERCOM_MAX_RETRIES=3
