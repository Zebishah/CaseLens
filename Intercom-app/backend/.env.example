# Application
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
# Include every browser origin that calls the API. Render's own service URL is
# also allowed automatically when RENDER_EXTERNAL_URL is available.
CORS_ORIGINS=http://localhost:3001,https://nagumo-hr-intelligence.vercel.app,https://hr-intercom.onrender.com

# 0 for direct/local, 1 for one trusted proxy such as Render or ngrok.
TRUST_PROXY=0
RUN_API=true
RUN_WORKERS=false
JOB_PROCESSING_MODE=inline

# On-demand background execution (required only for JOB_PROCESSING_MODE=apify)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=kTSaFi1vV3eHoeZft
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_DEFAULT_MEMORY_MBYTES=512
APIFY_RUN_TIMEOUT_SECONDS=180
APIFY_REQUEST_TIMEOUT_MS=10000
APIFY_MAX_ATTEMPTS=3

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/db_name?sslmode=require
DATABASE_POOL_MAX=10
# Optional direct/non-pooled URL used by migration scripts.
DATABASE_MIGRATION_URL=

# Optional shared API rate-limit and directory/CC cache layer (Upstash rediss:// URL).
# Also required when JOB_PROCESSING_MODE=bullmq.
REDIS_URL=
REDIS_ENQUEUE_TIMEOUT_MS=2000
INTELLIGENCE_WORKER_CONCURRENCY=3
QUEUE_JOB_ATTEMPTS=5
QUEUE_BACKOFF_MS=1000

# Authentication
# Use different randomly generated values of at least 32 characters in production.
JWT_SECRET=replace-with-a-unique-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret
JWT_ISSUER=hr-intelligence-api
JWT_AUDIENCE=hr-intelligence-web
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=caseops_session
CSRF_COOKIE_NAME=caseops_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Gemini
LLM_MODE=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROMPT_VERSION=extraction-v5
EMPLOYEE_MATCH_MIN_CONFIDENCE=75
MANUAL_REVIEW_CONFIDENCE=60

# Public demo limits
DEMO_SESSION_TTL_HOURS=24
DEMO_AUTH_TTL_MINUTES=30
DEMO_MAX_EMAILS=8
DEMO_MAX_SAMPLE_CASES=12
DEMO_MAX_LIVE_LLM=3
DEMO_RETENTION_HOURS=48

# Optional Resend inbound email
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_DOMAIN=

# Account verification and workspace invitations (Resend sending API).
# Independent of RESEND_ENABLED, which controls inbound email processing above.
RESEND_AUTH_EMAIL_ENABLED=false
RESEND_FROM_EMAIL=access@example.com
RESEND_FROM_NAME=Case Lense
EMAIL_VERIFICATION_TTL_MINUTES=30
# In production this must be the public HTTPS URL of the deployed frontend.
PUBLIC_APP_URL=http://localhost:3001
INVITE_TTL_HOURS=48

# Optional Box directory sync
BOX_SYNC_ENABLED=false
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FILE_ID=
STORE_DIRECTORY_SYNC_CRON=0 0 * * *

# Optional S3
S3_ENABLED=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional monitoring
MONITORING_ENABLED=false
SENTRY_DSN=

# Intercom Developer Workspace
INTERCOM_ENABLED=false
INTERCOM_ACCESS_TOKEN=
INTERCOM_CLIENT_SECRET=
INTERCOM_API_BASE_URL=https://api.intercom.io
INTERCOM_API_VERSION=2.16
INTERCOM_WORKSPACE_ID=
INTERCOM_ADMIN_ID=
INTERCOM_WRITEBACK_TAGS_ENABLED=true

# Local seed accounts (read by the seed scripts)
# SEED_ADMIN_EMAIL=operator@example.com
# SEED_ADMIN_PASSWORD=generate-a-strong-unique-password
# SEED_ADMIN_NAME=Demo Operator
# SEED_VIEWER_EMAIL=reviewer@example.com
# SEED_VIEWER_PASSWORD=generate-a-strong-unique-password
# SEED_VIEWER_NAME=Recruiter Review
