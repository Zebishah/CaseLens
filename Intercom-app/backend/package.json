{
  "name": "hr-intelligence-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:render": "npm install --include=dev && npm run build",
    "start": "node dist/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "migrate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:extensions": "tsx scripts/enable-extensions.ts",
    "db:push": "npm run db:extensions && tsx node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx scripts/seed-milestone1.ts",
    "db:migrate-intelligence": "tsx scripts/apply-intelligence-schema-migration.ts",
    "db:migrate-employee-scope": "tsx scripts/apply-employee-scope-schema-migration.ts",
    "db:migrate-related-case-scope": "tsx scripts/apply-related-case-scope-schema-migration.ts",
    "db:migrate-app-logs": "tsx scripts/apply-app-logs-schema-migration.ts",
    "db:cleanup-app-logs": "tsx scripts/cleanup-app-logs.ts",
    "db:cleanup-first-intercom": "tsx scripts/cleanup-first-intercom-employee.ts",
    "db:cleanup-si": "tsx scripts/cleanup-si-employee.ts",
    "db:migrate-store-directory": "tsx scripts/apply-store-directory-schema-migration.ts",
    "sync:store-directory": "tsx scripts/sync-store-directory.ts",
    "db:seed-store-directory-test": "tsx scripts/seed-store-directory-test.ts",
    "db:migrate-portfolio": "tsx scripts/apply-portfolio-ingestion-schema-migration.ts",
    "db:migrate-intercom-sync": "tsx scripts/apply-intercom-sync-schema-migration.ts",
    "db:migrate-intercom-source-revision": "tsx scripts/apply-intercom-source-revision-schema-migration.ts",
    "db:migrate-apify-actor-runs": "tsx scripts/apply-apify-actor-runs-schema-migration.ts",
    "db:migrate-refresh-sessions": "tsx scripts/apply-refresh-sessions-schema-migration.ts",
    "db:migrate": "tsx scripts/run-ordered-migrations.ts",
    "db:migrate-recruiter-access": "tsx scripts/apply-recruiter-access-schema-migration.ts",
    "db:seed-portfolio": "tsx scripts/seed-portfolio.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "eval:run": "tsx scripts/run-evaluation.ts",
    "bench:local": "tsx scripts/benchmarks/run-local-benchmarks.ts",
    "test:webhook": "bash scripts/test-webhook.sh",
    "intercom:fetch": "tsx scripts/fetch-intercom-conversation.ts",
    "intercom:smoke": "tsx scripts/intercom-smoke.ts",
    "intercom:canvas-smoke": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/integration/canvas/canvas.contract.smoke.test.ts tests/integration/canvas/canvas.test.ts",
    "intercom:sync": "tsx scripts/sync-intercom-conversations.ts",
    "db:seed-viewer": "tsx scripts/seed-viewer.ts"
  },
  "dependencies": {
    "apify": "3.7.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.4",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pgvector": "^0.2.1",
    "read-excel-file": "^9.3.10",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}
