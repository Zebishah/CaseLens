{
  "actorSpecification": 1,
  "name": "hr-intelligence-worker",
  "title": "HR Intelligence Worker",
  "description": "Private, on-demand execution for HR case intelligence and bounded maintenance jobs.",
  "version": "1.0",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "dockerContextDir": "..",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "usesStandbyMode": false,
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 1024,
  "defaultMemoryMbytes": 512,
  "environmentVariables": {
    "NODE_ENV": "production",
    "RUN_API": "false",
    "RUN_WORKERS": "false",
    "JOB_PROCESSING_MODE": "apify",
    "DATABASE_POOL_MAX": "4"
  }
}
