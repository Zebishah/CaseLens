# Browser origin only. Never put backend or production secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_NAME=Case Lense
NEXT_PUBLIC_DEMO_MODE=true

# Used only for the administrator's Intercom deep link.
# Public visitors receive an invitation at their own email after approval.
NEXT_PUBLIC_INTERCOM_WORKSPACE_URL=
NEXT_PUBLIC_INTERCOM_WORKSPACE_NAME=Nagumo Workspace [DEV]

# Optional iframe-compatible override. The Guidde walkthrough below is used by default.
NEXT_PUBLIC_DEMO_VIDEO_EMBED_URL=https://embed.app.guidde.com/playbooks/t7C9ZYEfhucV5Bh2iwYw14?mode=videoOnly

# Optional public image/CDN overrides for sanitized product screenshots.
# When omitted, the optimized screenshots in public/product-screenshots are used.
NEXT_PUBLIC_DEMO_SCREENSHOT_INBOX_URL=
NEXT_PUBLIC_DEMO_SCREENSHOT_CANVAS_URL=
NEXT_PUBLIC_DEMO_SCREENSHOT_DASHBOARD_URL=
