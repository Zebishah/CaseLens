# Browser origin only. Never put backend or production secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_APP_NAME=HR Intelligence
NEXT_PUBLIC_DEMO_MODE=true

# Deep link to the synthetic Intercom Inbox used by portfolio reviewers.
NEXT_PUBLIC_INTERCOM_WORKSPACE_URL=
NEXT_PUBLIC_INTERCOM_WORKSPACE_NAME=HR Intelligence demo

# Intentionally public credentials for a restricted synthetic-only Intercom teammate.
# Never use a personal account, employer data, or a password reused anywhere else.
NEXT_PUBLIC_INTERCOM_DEMO_EMAIL=
NEXT_PUBLIC_INTERCOM_DEMO_PASSWORD=

# Use an iframe-compatible YouTube, Vimeo, or Loom embed URL.
NEXT_PUBLIC_DEMO_VIDEO_EMBED_URL=
